# HTTP API bearer secret, at least 32 characters; also used by local clients.
API_TOKEN=<your-api-token-at-least-32-characters>
# Hugging Face secret with accepted gated LTX licences; sync only.
HF_TOKEN=<your-hugging-face-token>
# Runtime mode: pod exposes HTTP, serverless uses the Runpod queue handler.
MODE=pod
# Persistent mounted network-volume root; autodetects /runpod-volume then /workspace.
VOLUME_ROOT=/workspace
# Permit a writable non-mounted root for explicitly temporary experiments.
ALLOW_EPHEMERAL=false
# Concurrent slots per GPU; BF16 profiles require exactly one.
SLOTS_PER_GPU=1
# Installed ComfyUI source root.
COMFY_ROOT=/opt/ComfyUI
# Python interpreter for the isolated ComfyUI environment.
COMFY_PYTHON=/opt/venvs/comfy/bin/python
# Python interpreter for the isolated LTX native environment.
LTX_PYTHON=/opt/venvs/ltx/bin/python
# First loopback ComfyUI port; later GPU processes increment this.
COMFY_PORT=8188
# Override manifest path; default is the packaged data/manifest.yaml.
MANIFEST_PATH=/opt/h3ltx/src/h3ltx/data/manifest.yaml
# Default model groups checked by doctor and population commands.
MODEL_GROUPS=h3-core,h3-upscale,seedvr2,ltx-core,ltx-iclora
# Maximum accepted upload or URL-download size in bytes.
UPLOAD_MAX_BYTES=2147483648
# Maximum execution duration per GPU job, in seconds.
JOB_TIMEOUT_SECONDS=7200
# Idle pod stop delay in minutes; zero disables auto-stop.
IDLE_STOP_MINUTES=0
# Pod-scoped Runpod secret used only when idle auto-stop is enabled.
RUNPOD_API_KEY=<your-pod-scoped-runpod-key>
# Runpod injects the pod identity used by diagnostics and idle auto-stop.
RUNPOD_POD_ID=<injected-by-runpod>
# Runpod injects the data-centre identity; do not invent a deployment location.
RUNPOD_DC_ID=EUR-IS-1
# Optional ISO country code supplied by the operator after verifying location.
RUNPOD_COUNTRY=IS
# GPU-hour price for estimates; zero means no configured price, not free compute.
GPU_HOURLY_USD=0
# Image release tag, supplied by the image build.
IMAGE_VERSION=development
# Source revision, supplied by the image build.
GIT_SHA=unknown
# Scheduler queue-poll interval in seconds.
POLL_SECONDS=0.25
# GPU/cgroup metric sample interval in seconds.
METRIC_INTERVAL=0.5
# Client base URL; never include credentials in the URL.
H3LTX_URL=https://<pod-id>-8000.proxy.runpod.net
# Optional client token alias; API_TOKEN takes precedence.
H3LTX_TOKEN=<your-api-token>
# Hugging Face/Xet cache on persistent storage, outside image layers.
HF_HOME=/workspace/.cache/huggingface
# Optional SSH public key; private keys are never needed inside the container.
PUBLIC_KEY=<your-ssh-public-key>
# Optional PyTorch CUDA allocator policy; leave unset unless deliberately testing it.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Optional NVIDIA TF32 policy; recorded when supplied.
# NVIDIA_TF32_OVERRIDE=0
# Optional deterministic cuBLAS workspace policy; recorded when supplied.
# CUBLAS_WORKSPACE_CONFIG=:4096:8
